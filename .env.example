# Coffein — produksi (docker compose up -d --build)

# Database
POSTGRES_USER=coffein
POSTGRES_PASSWORD=coffein
POSTGRES_DB=coffein

# Auth — WAJIB ganti di produksi
JWT_SECRET=ganti-dengan-secret-acak-panjang
JWT_EXPIRES_IN=12h
ADMIN_EMAIL=admin@coffein.id
ADMIN_PASSWORD=admin12345

# Payment: "mock" (dev) | "mayar"
PAYMENT_PROVIDER=mock
MAYAR_API_KEY=
MAYAR_BASE_URL=https://api.mayar.id
MAYAR_WEBHOOK_SECRET=

# URL publik
APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Seed menu + admin saat start
SEED_ON_START=true
