# Coffein — produksi (docker compose up -d --build)

# Database
POSTGRES_USER=coffein
POSTGRES_PASSWORD=coffein
POSTGRES_DB=coffein

# Auth — WAJIB ganti di produksi
JWT_SECRET=ganti-dengan-secret-acak-panjang
JWT_EXPIRES_IN=12h
ADMIN_EMAIL=admin@coffein.id
ADMIN_PASSWORD=admin12345

# Payment: "mock" (dev) | "midtrans" | "cash"
PAYMENT_PROVIDER=midtrans

# Midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_SIGNATURE_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# CORS Configuration
# FRONTEND_ORIGIN: URL frontend (default: http://localhost:3000)
# NGROK_ORIGIN: URL ngrok untuk development (optional, contoh: https://xxx.ngrok-free.dev)
# ALLOW_ALL_CORS: Set=1 untuk mengizinkan semua origin (hanya untuk development lokal)
# Contoh: FRONTEND_ORIGIN=http://localhost:3000 NGROK_ORIGIN=https://viewpoint-dreamlike-juggle.ngrok-free.dev

# URL publik
APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Seed menu + admin saat start
SEED_ON_START=true
