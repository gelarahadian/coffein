# Database
DATABASE_URL="postgresql://user:password@localhost:5432/coffein"

# Auth — WAJIB diganti di produksi
JWT_SECRET=""
JWT_EXPIRES_IN="12h"

# Seed admin
ADMIN_EMAIL="admin@coffein.id"
ADMIN_PASSWORD=""

# Payment: "mock" | "midtrans" | "cash"
PAYMENT_PROVIDER="midtrans"

# Midtrans
MIDTRANS_SERVER_KEY=""
MIDTRANS_SIGNATURE_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION=false

# URL publik web
APP_URL="http://localhost:3000"

# CORS Configuration
# FRONTEND_ORIGIN: URL frontend (default: http://localhost:3000)
# NGROK_ORIGIN: URL ngrok untuk development (optional)
# ALLOW_ALL_CORS: Set=1 untuk mengizinkan semua origin (hanya untuk development lokal)
PORT=4000
